{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sagasu",
  "version": "0.1.0",
  "identifier": "jp.sagasu.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sagasu",
        "width": 860,
        "height": 620,
        "minWidth": 560,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Nishi-Yura",
    "copyright": "© 2026 Nishi-Yura",
    "category": "Utility",
    "shortDescription": "名前でも中身でも、すぐ見つかるファイル検索",
    "longDescription": "Sagasu はファイル名・中身・文章で瞬時にファイルを探し、AI の整理案をプレビューしてから安全にフォルダを片付ける Windows 用ツールです。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "ja-JP"
      }
    }
  }
}
